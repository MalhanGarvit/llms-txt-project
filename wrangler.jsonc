{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "txtllms",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // serves /about from public/about.html, replacing the old Express routes
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Cloudflare Email Sending. Needs the zone enabled for mail.txtllms.com first;
  // see DEPLOY-CLOUDFLARE.md.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["files@mail.txtllms.com"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
